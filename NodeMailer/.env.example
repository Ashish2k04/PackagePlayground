# The port on which the Express server will run (98)
PORT=3000

# Google OAuth Client ID (99)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Google OAuth Client Secret (100)
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Google OAuth Refresh Token (101)
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# The Gmail address used to send emails (102)
GOOGLE_USER=YOUR_EMAIL

# To get all four Google OAuth values, read the README.md (103)